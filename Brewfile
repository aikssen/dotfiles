# Brewfile — apps CLI del entorno de desarrollo.
# Instalar todo con:  brew bundle --file=~/dotfiles/Brewfile

brew "antidote"    # gestor de plugins de zsh (rapido, declarativo)
brew "eza"         # ls moderno con iconos y colores
brew "fastfetch"   # info del sistema
brew "fd"          # find moderno (usado por nvim/telescope)
brew "ffmpeg"      # previews de video/audio en yazi
brew "fzf"         # fuzzy finder
brew "gh"          # GitHub CLI
brew "git"
brew "herdr"       # multiplexor de terminal para agentes de IA (config en herdr/)
brew "imagemagick" # previews de imagen (SVG/HEIC/fuentes) en yazi
brew "jq"          # previews de JSON en yazi
brew "lazygit"     # TUI de git (integrado en nvim: <leader>gg)
brew "mise"        # gestor de versiones (node, python, etc.)
brew "neovim"      # editor / IDE (config LazyVim en nvim/)
brew "nushell"     # shell alternativa
brew "poppler"     # previews de PDF en yazi
brew "sevenzip"    # previews de archivos comprimidos en yazi
brew "starship"    # prompt
brew "stow"        # gestor de symlinks de estos dotfiles (necesario para bootstrap)
brew "tmux"        # multiplexor de terminal
brew "tree"        # arbol de directorios
brew "uv"          # gestor de paquetes/venv de Python
brew "yazi"        # explorador de archivos de terminal (TUI)
brew "zoxide"      # cd inteligente

# --- Nerd Fonts ---
# Necesarias para los iconos de Neovim (neo-tree, lualine) y starship.
# Tras instalarlas hay que SELECCIONARLAS en el terminal (ver README).
cask "font-jetbrains-mono-nerd-font"
cask "font-fira-code-nerd-font"
cask "font-geist-mono-nerd-font"
